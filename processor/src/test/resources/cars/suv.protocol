typestate SUV {
    OFF = {
        turnOn() : <true : COMFORT_ON, false : OFF>,
        drop : end
    }

    COMFORT_ON = {
        turnOff() : OFF,
        setSpeed(int) : COMFORT_ON,
        switchMode() : <SPORT : SPORT_ON, COMFORT : COMFORT_ON>,
        setEcoDrive(boolean) : COMFORT_ON
    }

    SPORT_ON = {
        turnOff() : OFF,
        setSpeed(int) : SPORT_ON,
        switchMode() : <SPORT : SPORT_ON, COMFORT : COMFORT_ON>,
        setFourWheels(boolean) : SPORT_ON
    }
}